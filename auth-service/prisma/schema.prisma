generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int         @id @default(autoincrement())
  full_name     String
  email         String      @unique
  phone_number  String
  password      String
  created_at    DateTime    @default(now())
}
